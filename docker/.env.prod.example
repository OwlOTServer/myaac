# Copie para docker/.env.prod no servidor e preencha os valores reais.
# Este arquivo NÃO é commitado (ver .gitignore).

# MyAAC web port — não exponha 80 diretamente; o nginx-proxy faz isso
MYAAC_PORT=8080

# Database — IP local do Windows onde o Canary/MySQL roda via Docker
DB_HOST=192.168.15.8
DB_PORT=3306
DB_USER=TROQUE_AQUI
DB_PASS=TROQUE_AQUI
DB_NAME=otservbr-global
