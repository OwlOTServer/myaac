# Copie para docker/.env.prod no servidor e preencha os valores reais.
# Este arquivo NÃO é commitado (ver .gitignore).

# MyAAC web port — não exponha 80 diretamente; o nginx-proxy faz isso
MYAAC_PORT=8080

# Caminho do servidor Canary no host (Debian server)
CANARY_PATH=/opt/servidor/canary

# Database — mesmas credenciais do docker-compose do Canary
DB_HOST=database
DB_PORT=3306
DB_USER=root
DB_PASS=TROQUE_AQUI
DB_NAME=otservbr-global
